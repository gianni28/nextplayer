rules_version = '2';

// Cada usuario solo puede leer y escribir su propio documento de favoritos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favorites'])
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 500;
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
